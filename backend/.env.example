# 서버 (기본값: 0.0.0.0:9000). 배포 환경에서는 start 명령의 $PORT를 쓴다
APP_HOST=0.0.0.0
APP_PORT=9000
APP_APP_NAME=Berlin Saenuree Server
APP_API_VERSION=v1

# CORS 설정 (프론트엔드 URL로 변경)
APP_ALLOWED_ORIGINS=["http://localhost:9090"]

# Site admin 이메일 (콤마 구분, 최소 1개·복수 허용). 레거시 APP_ADMIN_EMAIL 은 사용하지 않음
APP_ADMIN_EMAILS=change-this@example.com
# true면 Settings에서 Page Admin 계정 추가·로그인 가능 (env site admin과 별개)
APP_PAGE_ADMIN_ENABLED=false

# JWT 설정 (반드시 변경! 32자 이상 랜덤 문자열, 사이트마다 다른 값)
APP_JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
# 토큰 iss 값. 비우면 APP_NAME의 slug. 사이트마다 다르게 둔다
APP_SITE_ID=
APP_JWT_ALGORITHM=HS256
APP_JWT_EXPIRATION_MINUTES=30

# 이메일 설정 (Gmail 사용 예시)
APP_SMTP_HOST=smtp.gmail.com
APP_SMTP_PORT=587
APP_SMTP_USERNAME=change-this-admin-name
APP_SMTP_PASSWORD=change-this-secure-password
APP_SMTP_FROM_EMAIL=change-this-admin-email
APP_SMTP_FROM_NAME=Berlin Saenuree
APP_SEND_REAL_EMAIL=False

# 데이터 디렉터리 (비우면 backend/ 기준)
APP_DATA_ROOT=
# 백업 저장 디렉터리 (비우면 APP_DATA_ROOT/backups). data/ 바깥의 영구 디스크 경로
APP_BACKUP_ROOT=
# 복구·백업 삭제용 별도 비밀번호. 배포 환경에서 강한 임의 값으로 설정
APP_BACKUP_PASSWORD=
# ZIP 업로드 크기 제한 (bytes, 기본 512MB) 및 압축 해제 크기 제한 (기본 2GB)
APP_BACKUP_MAX_ARCHIVE_BYTES=536870912
APP_BACKUP_MAX_EXPANDED_BYTES=2147483648
# 휴지통 게시물 보관 기간 (일)
APP_POSTS_TRASH_RETENTION_DAYS=30
# 휴지통 Blogger 보관 기간 (일)
APP_BLOGGER_TRASH_RETENTION_DAYS=30

# 미디어 파일 업로드 최대 크기 (bytes, 기본 100MiB)
APP_MEDIA_MAX_FILE_BYTES=104857600
# 미디어 업로드를 제외한 요청 본문 최대 크기 (bytes, 기본 5MB). 초과하면 413
APP_MAX_REQUEST_BODY_BYTES=5242880

# 앱 내부 정기 작업 (휴지통 만료 정리, orphan 미디어 수거). 6시간마다 실행, 시작 5분 후 첫 실행
APP_MAINTENANCE_ENABLED=True
# true면 orphan 미디어를 로그로만 남기고 삭제하지 않는다. 로그 확인 후 false로 바꾼다
APP_MEDIA_GC_DRY_RUN=True

# 앞단 신뢰 프록시 수. Render 등 프록시 뒤는 1, 프록시 없이 직접 실행하면 0
APP_TRUSTED_PROXY_HOPS=1

# 로컬 개발은 True, 프로덕션은 False
APP_DEBUG=True
